# ======================================================
# Glitch 部署环境变量模板
# 复制此文件内容到 Glitch 项目的 .env 中（Glitch 的 Tools → .env）
# ======================================================

# MiMo LLM API
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE=https://api.xiaomimimo.com/v1

# JWT 配置
JWT_SECRET=your-random-secret-change-me
JWT_EXPIRES_IN=7d

# 前端地址（CORS 白名单，必须精确匹配你的前端域名）
FRONTEND_URL=https://your-frontend-domain.vercel.app

# GitHub OAuth（在 GitHub Developer Settings → OAuth Apps 中创建/更新）
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# 注意：GITHUB_CALLBACK_URL 必须与 GitHub OAuth App 中配置的回调地址完全一致
GITHUB_CALLBACK_URL=https://your-project-name.glitch.me/api/auth/github/callback

# 注意：PORT 不需要设置！Glitch 会自动注入 PORT 环境变量，
# server.js 中的 process.env.PORT || 3001 会自动使用 Glitch 提供的端口
