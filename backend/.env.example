# ==================== LangChain RAG 配置（完整说明见根目录 LANGCHAIN_RAG.md） ====================

# --- LLM（回答生成，任意 OpenAI 兼容服务）---
# 未设置 LLM_* 时回退旧变量 MIMO_*（已不推荐：默认的 api.mimo.com 无法解析）
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-3.0-flash          # 该服务另有 agnes-2.5-flash（更快）等，GET /v1/models 可查
# 未配置好 LLM 时问答会明确降级为"仅检索"，可用 /api/health 的 has_llm 字段确认
# LLM_TEMPERATURE=0.85
# LLM_MAX_TOKENS=1500
# LLM_ENABLED=false   （强制关闭 LLM，仅返回检索结果，适合离线调试）

# --- 向量嵌入 ---
# local（默认）：本地中文嵌入模型 bge-small-zh-v1.5（512 维），离线可用、零成本，模型缓存 backend/.cache
# openai：OpenAI 兼容 embedding API（默认复用 LLM_API_BASE / LLM_API_KEY）
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=Xenova/bge-small-zh-v1.5
# 换模型=换向量空间，索引会自动要求重建（npm run ingest）；实测对比见 data/eval-reports/
# EMBEDDINGS_API_BASE=
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BATCH_SIZE=32
# HF_ENDPOINT=https://hf-mirror.com   （首次下载模型超时/失败时启用镜像；代理证书异常时可再加 NODE_OPTIONS=--use-system-ca）
# 模型已存在于 backend/.cache/Xenova/<模型名>/ 时，嵌入阶段完全不走网络，无需任何镜像配置

# --- 向量存储 ---
# memory（默认）：内存向量库 + JSON 持久化（零外部依赖，生产兜底）
# chroma：ChromaDB 服务端（本地启动方式见 CHROMA_SETUP.md）
# auto：优先探测 Chroma 服务端（3 秒超时），不可用自动回退 memory
VECTOR_BACKEND=auto
# VECTOR_STORE_PATH=./vector_store_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
# CHROMA_TOKEN=服务端开启 token 鉴权时填写
# CHROMA_COLLECTION=interview_knowledge
# CHROMA_CONNECT_TIMEOUT_MS=30000

# --- 文档分块 ---
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120

# --- 检索与上下文 ---
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.5      （0~1 相似度阈值，低于阈值的结果被过滤；0 表示不过滤）
#   实测（bge-small-zh + 60 条标注）：0.5 以下拒答率 0%，0.5 拒掉 20% 无关查询且真命中零损失，
#   0.55 开始误伤（保留 71.1%），0.6 时保留跌到 57.8% —— 所以 0.5 是免费的下限，别指望它做"拒答"
# RAG_CONTEXT_MAX_CHARS=2000

# --- 知识库导入（npm run ingest）---
# RAG_SOURCES=data/documents.json   （逗号分隔：.json 知识库 / .txt·.md 文件 / 目录）
# RAG_INGEST_LIMIT=0                （调试：只导入前 N 个文档，0 为全量）
# RAG_BATCH_SIZE=64

# ==================== 服务与账号 ====================
PORT=3001

# --- AI 接口成本护栏（不填则用下列默认值）---
# 滑动窗口计数，按 IP（已登录则按用户）；单进程内存实现，多实例部署需换共享存储
# GUARD_WINDOW_MS=60000            （窗口长度，毫秒）
# CHAT_RATE_MAX=20                 （问答：每窗口 20 次，超出返回 429 + Retry-After）
# RESUME_RATE_MAX=5                （简历优化：每窗口 5 次，且必须登录）
# LLM_MAX_CONCURRENT=2             （同时进行的 LLM 请求数，超出的先排队）
# LLM_MAX_QUEUE=10                 （队列已满 → 503）
# LLM_QUEUE_WAIT_MS=15000          （排队超过该毫秒数 → 503）

# GitHub OAuth 配置（在 GitHub Developer Settings 创建 OAuth App 获取）
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# JWT 配置
JWT_SECRET=your_random_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 前端地址（CORS + OAuth 回调使用）
FRONTEND_URL=http://localhost:5173

# 管理员账号配置
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
